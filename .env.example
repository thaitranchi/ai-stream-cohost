# --- Core LLM ---
# llm_provider: "openai" or "openrouter"
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Persona prompt for the co-host. Polite to viewers, sarcastic to the streamer.
PERSONA_PROMPT=You are the streamer's witty AI co-host. Be polite and cheerful toward viewers, but playfully sarcastic about the streamer's gaming skills.

# Keywords/mentions that trigger a response (comma-separated)
TRIGGER_WORDS=@Bot,Cậu Vàng

# --- Text-to-Speech ---
TTS_PROVIDER=gtts
TTS_LANG=vi

# --- YouTube Live Chat connector (optional) ---
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=
YOUTUBE_LIVE_CHAT_ID=
YOUTUBE_POLL_SECONDS=5
