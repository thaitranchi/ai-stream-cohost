# --- Core LLM ---
# llm_provider: "openai" or "openrouter"
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Persona prompt for the co-host. Polite to viewers, sarcastic to the streamer.
PERSONA_PROMPT=You are the streamer's witty AI co-host. Be polite and cheerful toward viewers, but playfully sarcastic about the streamer's gaming skills.

# Keywords/mentions that trigger a response (JSON array)
TRIGGER_WORDS=["@Bot","Cậu Vàng"]

# --- Text-to-Speech ---
TTS_PROVIDER=gtts
TTS_LANG=vi

# Set to true on cloud deployments (no audio device)
DISABLE_AUDIO=false

# --- YouTube Live Chat connector (optional) ---
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=
YOUTUBE_LIVE_CHAT_ID=
YOUTUBE_POLL_SECONDS=5

# YouTube auth: "api_key" (read-only, default) or "oauth" (user-authenticated).
# OAuth enables posting co-host replies back to chat.
YOUTUBE_AUTH_MODE=api_key
# Path to the OAuth client secret JSON (Desktop app) downloaded from Google Cloud.
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# Cached OAuth credentials (auto-created on first consent). Keep this secret.
YOUTUBE_OAUTH_TOKEN_FILE=token.json
# Comma-separated OAuth scopes. Add the force-ssl scope to allow posting replies.
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly
# When True (and OAuth has a write scope), the co-host reply is posted to chat.
YOUTUBE_POST_REPLIES=false
